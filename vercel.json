{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm --prefix vedx install",
  "buildCommand": "npm run build",
  "outputDirectory": "combined-dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/azure-learning(?:/.*)?",
      "dest": "/azure-learning/index.html"
    }
  ]
}
